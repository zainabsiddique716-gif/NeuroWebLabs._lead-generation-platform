# Neon Postgres - Neon dashboard se connection string copy karein
# aur 'postgresql://' ko 'postgresql+pg8000://' se replace kar dein
DATABASE_URL=postgresql+pg8000://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Agar DATABASE_URL yahan set nahi karte, app khud SQLite (local_dev.db) use kar lega

# Email outreach (SMTP) - Gmail use kar rahe hain to "App Password" banayein
# (Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
FROM_EMAIL=youremail@gmail.com

# IMPORTANT: true rakhein jab tak sending pura test na ho jaye.
OUTREACH_DRY_RUN=true

# Kitni emails per day bhej sakte hain (spam se bachne ke liye)
DAILY_SEND_LIMIT=50

# Scheduler kitne ghante baad saved searches dobara chalaye
SCHEDULE_INTERVAL_HOURS=24

# Geonode Scraper API - website scraping ke liye (proxy + extraction)
# https://app.geonode.com/scraper-api se API key banayein
GEONODE_API_KEY=your_geonode_api_key_here
